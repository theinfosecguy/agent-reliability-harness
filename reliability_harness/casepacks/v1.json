  "cases": [
    {
      "id": "happy_refund",
      "version": "1.0.0",
      "suites": ["smoke", "full"],
      "description": "Nominal full-refund workflow.",
      "request": {"event_id": "evt-happy", "order_id": "ord-happy", "reason": "duplicate_order", "channel": "email"},
      "initial_order": {"order_id": "ord-happy", "amount": 120.0, "currency": "USD", "status": "paid", "version": 1},
      "faults": [],
      "special": {},
      "expected": {
        "tool_sequence": ["lookup_order", "get_refund_policy", "issue_refund", "notify_customer"],
        "required_args": {
          "lookup_order": {"order_id": "ord-happy"},
          "get_refund_policy": {"reason": "duplicate_order"},
          "issue_refund": {"order_id": "ord-happy", "amount": 120.0, "currency": "USD"},
          "notify_customer": {"order_id": "ord-happy", "channel": "email"}
        },
        "final_order": {"status": "refunded", "refunded_amount": 120.0, "refund_effect_count": 1, "notifications": [{"channel": "email", "message": "refund_confirmed"}]}
      }
    },
